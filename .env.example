# ------------------------------------------------------------------
# RapiJob — variables de entorno
# Copia este archivo como .env y completa los valores que necesites.
# La app funciona SIN estas variables en "modo demo" (datos locales).
# ------------------------------------------------------------------

# Supabase (opcional). Si defines ambas, la app usa Supabase como backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps (opcional). Sin clave, se usa OpenStreetMap/Leaflet como mapa.
# Restringe la clave a los dominios de tu web en Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Centro inicial del mapa (opcional). Por defecto: Huancayo, Perú.
VITE_DEFAULT_LAT=-12.0651
VITE_DEFAULT_LNG=-75.2049
